# Copy this file to .env and edit the values before running the server.

# Password required to access the admin panel. Change this to something
# only you know before you deploy — anyone with this password can add,
# edit, and delete listings.
# The server refuses to start with NODE_ENV=production while this is
# unset or still "yibro2026".
ADMIN_PASSWORD=sinte16

# Random long string used to sign session cookies. Change this to any
# long random value (it doesn't need to be memorable).
# Must be at least 24 characters in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=SESSION_SECRET=3a026c5cb94b1297f6d627180fbf89eb82ebb001acce236d915a63a1dda85f80

# Port the server listens on. Most hosting platforms set this for you
# automatically and ignore whatever you put here.
PORT=3000

# Set to production on a live server. This turns the config warnings above
# into hard errors and marks the session cookie Secure.
NODE_ENV=development

# Set to 1 when the app sits behind a proxy or host that terminates HTTPS
# (Render, Railway, Nginx, Cloudflare...). This is what lets the session
# cookie be marked Secure and enables HSTS.
TRUST_PROXY_HTTPS=0
